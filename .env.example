# RPC endpoints
POLYGON_AMOY_RPC_URL=
POLYGON_RPC_URL=
POLYGONSCAN_API_KEY=

# Deployer: use a hardware wallet or `cast wallet import` keystore in production.
# The key is only read by script/Deploy.s.sol when running locally / on testnet.
PRIVATE_KEY=

# ---- Phase 1 deployment (script/DeployPhase1.s.sol) ----
ADMIN=                 # Timelock or Safe that ends up as admin
REGISTRAR=             # company wallet that registers assets
ALLOCATOR=             # treasury ops wallet that allocates reserves
DAO_MEMBERS=           # comma-separated member addresses
DAO_VOTING_PERIOD=259200   # 3 days
DAO_QUORUM=2
DAO_THRESHOLD_BPS=6667     # two-thirds of For + Against
POR_SNAPSHOT_INTERVAL=3600

# ---- Phase 2 deployment (script/Deploy.s.sol) ----
# Phase 1 contracts this phase plugs into
RESERVE_MANAGER=
TREASURY=
USDC=

# Governance and operations
DAO_TIMELOCK=          # Phase 1 Timelock (GOVERNOR_ROLE)
EMERGENCY_MULTISIG=    # Safe multisig (PAUSER_ROLE)
SETTLEMENT_OPERATOR=   # Settlement API signer (SETTLER_ROLE)
TREASURY_OPS=          # Treasury ops wallet (MINT_REQUESTER_ROLE)

# Chainlink-style price feed for the stablecoin (8 decimals)
PRICE_FEED=
PRICE_MAX_STALENESS=3600

# Initial risk parameters
MIN_COLLATERAL_RATIO_BPS=15000  # 150%
DEBT_CEILING=10000000000000000000000000  # 10,000,000 VGUSD (18 decimals)
REDEMPTION_DISCOUNT_BPS=50       # 0.5%
