# Server Configuration
PORT=3001
NODE_ENV=development

# Blockchain Network Configuration
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Settlement Signer (Dedicated account holding SETTLER_ROLE on RedemptionModule)
# In local Anvil: Account #7 holds SETTLER_ROLE
SETTLEMENT_SIGNER_KEY=0x4bbbf85ce3377467afe5d46f804f221813b2bb87f24d81f60f1fcdbf7cbf4356
# Optional fallback if SETTLEMENT_SIGNER_KEY is unset
PRIVATE_KEY=

# Contract Addresses (Populated from deployment, e.g. make demo-deploy)
ASSET_REGISTRY_ADDRESS=0x5fbdb2315678afecb367f032d93f642f64180aa3
VITA_STABLECOIN_ADDRESS=0x0b306bf915c4d645ff596e518faf3f9669b97016
COLLATERAL_CONTROLLER_ADDRESS=0x959922be3caee4b8cd9a407cc3ac1c251c2007b1
REDEMPTION_MODULE_ADDRESS=0x68b1d87f95878fe05b998f19b66f4baba5de1aed
RESERVE_MANAGER_ADDRESS=0x9fe46736679d2d9a65f0992f2272de9f3c7fa6e0

# Security & Operational Settings
# Required key for triggering write endpoints like POST /api/settlement/settle
SETTLEMENT_API_KEY=vittagems-settlement-secret-key-change-in-production
# Comma-separated list of allowed CORS origins or *
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Persistence & Storage
DB_PATH=./data/vittagems.db

# Blockchain Confirmations to wait for settlement
CONFIRMATIONS=1
